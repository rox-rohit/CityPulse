# Copy to .env and adjust for your machine. Never commit the real .env file.

# PostgreSQL + PostGIS connection string
DATABASE_URL=postgresql+psycopg2://citypulse:citypulse_password@localhost:5432/citypulse

# Browser origins allowed to call the API (comma-separated).
# Set this to your deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional: XKDR India Air Quality API key, used by station_ingest.py to pull
# CPCB CAAQMS ground observations. Sign up at https://airquality.xkdr.org/signup
# Without a key the platform still runs and reports observed data as unavailable.
# XKDR_AQI_KEY=

# AOI polygon used by the ingestion pipeline (defaults to the Maharaj Bada polygon)
# AOI_GEOJSON=D:/city/citypulse-ai/static/aoi-maharaj-bada.geojson

# OSM extract used by the ingestion pipeline (Madhya Pradesh, via OSM France)
OSM_EXTRACT_URL=https://download.openstreetmap.fr/extracts/asia/india/madhya_pradesh-latest.osm.pbf
# OSM_EXTRACT=D:/city/citypulse-ai-backend/.cache/osm/madhya_pradesh.osm.pbf

# Overpass response cache directory
# CITYPULSE_CACHE=D:/city/citypulse-ai-backend/.cache
